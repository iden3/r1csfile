{
  "name": "r1csfile",
  "type": "module",
  "version": "0.0.48",
  "description": "r1cs file format parser",
  "exports": {
    ".": {
      "import": "./src/r1csfile.js",
      "require": "./build/main.cjs"
    }
  },
  "main": "./build/main.cjs",
  "module": "./src/r1csfile.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "lint": "eslint .",
    "clean": "rimraf build",
    "pretest": "npm run build:node && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest --project node-esm",
    "build:node": "vite build",
    "build": "npm run clean && npm run build:node"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iden3/r1csfile.git"
  },
  "keywords": [
    "r1cs",
    "circom",
    "zero",
    "knoledge",
    "format",
    "parser"
  ],
  "author": "Jordi Baylina",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/iden3/r1csfile/issues"
  },
  "homepage": "https://github.com/iden3/r1csfile#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "rimraf": "^6.1.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@iden3/bigarray": "0.0.2",
    "@iden3/binfileutils": "https://github.com/iden3/binfileutils.git#feat/esm-migration",
    "fastfile": "https://github.com/iden3/fastfile.git#feat/esm-migration",
    "ffjavascript": "https://github.com/iden3/ffjavascript.git#feat/esm-migration"
  }
}
